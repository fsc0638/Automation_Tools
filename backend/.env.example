DATABASE_URL=postgres://postgres:postgres@localhost:5432/kway_dev
JWT_SECRET=change-me-secret
JWT_EXPIRY_HOURS=24

# AES-256-GCM key (base64 of 32 bytes) for encrypting Git access tokens at rest.
# Generate one of:
#   openssl rand -base64 32
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# If unset, falls back to deriving from JWT_SECRET (warning logged at startup).
GIT_TOKEN_ENCRYPTION_KEY=

# OpenClaw Agent: connects to OpenClaw Gateway only.
OPENCLAW_API_URL=http://127.0.0.1:18789/v1
OPENCLAW_API_KEY=your-openclaw-gateway-token
OPENCLAW_MODEL=gpt-5.5

# Hermes Agent: independent local Hermes Agent/Gateway endpoint.
# Set these to your local Hermes Agent URL/token/model.
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=your-hermes-agent-token
HERMES_MODEL=hermes-agent

DEBATE_MAX_ROUNDS=12
DEBATE_AUTO_CONSENSUS=true

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info

DATABASE_URL=postgres://postgres:postgres@localhost:5432/kway_dev
JWT_SECRET=change-me-secret
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=30
# LOG_FORMAT=json for ingestion (Loki / ELK / Datadog / CloudWatch).
# Anything else (or unset) keeps pretty human-readable output for dev.
LOG_FORMAT=pretty

# AES-256-GCM key (base64 of 32 bytes) for encrypting Git access tokens at rest.
# Generate one of:
#   openssl rand -base64 32
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# If unset, falls back to deriving from JWT_SECRET (warning logged at startup).
GIT_TOKEN_ENCRYPTION_KEY=

# OpenClaw Agent: connects to OpenClaw Gateway only.
OPENCLAW_API_URL=http://127.0.0.1:18789/v1
OPENCLAW_API_KEY=your-openclaw-gateway-token
OPENCLAW_MODEL=gpt-5.5

# Hermes Agent: independent local Hermes Agent/Gateway endpoint.
# Set these to your local Hermes Agent URL/token/model.
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=your-hermes-agent-token
HERMES_MODEL=hermes-agent

# 0 = effectively unlimited (50-round safety ceiling). Consensus is
# detected automatically when both agents stop disagreeing, so the cap
# only kicks in for runaway loops.
DEBATE_MAX_ROUNDS=0
DEBATE_AUTO_CONSENSUS=true
# Max seconds to wait for the next visible streamed token from an agent.
# Hermes can spend longer thinking in late debate rounds, especially with large context.
AGENT_STREAM_CHUNK_TIMEOUT_SECS=300

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info

# CORS: comma-separated list of allowed origins. Empty or '*' = any origin (dev mode, NOT for prod).
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=

# ── Project data directory ───────────────────────────────────────────────────
# PROJECT_DATA_HOST_PATH  (docker-compose only)
#   The host-side bind mount target.  Docker maps this directory to /app/data
#   inside the container so the Mac Mini host can see (and back up) all project
#   files directly on disk.
#
#   Dev / local:   leave unset (defaults to ./data beside docker-compose.yml)
#   Mac Mini:      PROJECT_DATA_HOST_PATH=/Users/kwayrdc/kway-project-data
#
PROJECT_DATA_HOST_PATH=./data

# PROJECT_DATA_ROOT  (backend process — inside the container)
#   Where Git projects get cloned.  Per-project subdir is <repo-slug>-<8-hex>.
#   Existing projects keep their original local_path stored in DB; this only
#   affects newly created Git projects.
#   Inside Docker this is always /app/data/projects (mapped from host via bind mount).
PROJECT_DATA_ROOT=./data/projects

# ── Per-user encrypted disk images (macOS only) ──────────────────────────────
# DMG_ROOT: directory where per-user APFS-encrypted sparse images are stored.
# Leave blank (or unset) to disable — on Windows / Linux this is always a no-op.
# Recommended on the Mac Mini (kwayrdc):
#   DMG_ROOT=/Volumes/kway-data/dmg-store
# On login, the backend creates & mounts <DMG_ROOT>/<user_id>.sparseimage at
# <PROJECT_DATA_ROOT>/users/<user_id>/.  The passphrase is sealed in the vault
# (object_type=user_dmg_key, object_id=<user_id>) so only the owning user +
# admin recovery can decrypt.
DMG_ROOT=
# Maximum capacity per image in MiB (sparse — no pre-allocation). Default: 4096 (4 GiB).
DMG_SIZE_MB=4096

# Pricing per 1k tokens (USD) — drives the Cost tab in the dashboard.
# Defaults below match a typical low-tier model; adjust to match your gateway.
OPENCLAW_PRICE_PER_1K_INPUT=0.15
OPENCLAW_PRICE_PER_1K_OUTPUT=0.60
HERMES_PRICE_PER_1K_INPUT=0.15
HERMES_PRICE_PER_1K_OUTPUT=0.60

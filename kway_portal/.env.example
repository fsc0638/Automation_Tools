# Copy to .env and fill in real credentials.
# Convention:
#   KWAY_<NAME>             — session-wide (login, popup handling)
#   KWAY_<FEATURE>_<NAME>   — scoped to a single feature

# ── Session-wide ──────────────────────────────────────────────────────
KWAY_USERNAME=
KWAY_PASSWORD=
KWAY_PORTAL_URL=https://portal.kway.com.tw/Index.aspx
KWAY_TIMEOUT_MS=30000

# Optional: explicit login-form selectors if auto-detection fails.
KWAY_USERNAME_SELECTOR=
KWAY_PASSWORD_SELECTOR=
KWAY_LOGIN_BUTTON_SELECTOR=

# Optional: extra popup-close selectors (comma separated). Built-in
# defaults already cover KWay news modal, common close/confirm buttons,
# .modal .close, .swal2-confirm, etc.
KWAY_POPUP_CLOSE_SELECTORS=

# ── Feature: meeting-rooms ─────────────────────────────────────────────
KWAY_MEETING_ROOMS_BOOKING_URL=https://crm.kway.com.tw/portal_login.jsp?menuid=251510
KWAY_MEETING_ROOMS_LINK_TEXT=預訂會議室,預定會議室
KWAY_MEETING_ROOMS_RESULT_CONTAINER=body
